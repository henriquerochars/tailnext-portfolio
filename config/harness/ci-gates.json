      ],
      "revision": "integration",
      "notApplicableReasons": [
        "reviewed-docs-only"
      ]
    },
    {
      "id": "macos-lint",
      "job": "validate-macos",
      "argv": [
        "yarn",
        "lint"
      ],
      "timeoutSeconds": 120,
      "zeroSkips": false,
      "scope": [
        "portfolio"
      ],
      "revision": "integration",
      "notApplicableReasons": [
        "reviewed-docs-only"
      ]
    },
    {
      "id": "macos-build",
      "job": "validate-macos",
      "argv": [
        "yarn",
        "build"
      ],
      "timeoutSeconds": 300,
      "zeroSkips": false,
      "scope": [
        "portfolio"
      ],
      "revision": "integration",
      "notApplicableReasons": [
        "reviewed-docs-only"
      ]
    },
    {
      "id": "macos-browser-prepare",
      "job": "validate-macos",
      "argv": [
        "yarn",
        "playwright",
        "install",
        "--with-deps",
        "chromium"
      ],
      "timeoutSeconds": 300,
      "zeroSkips": false,
      "scope": [
        "portfolio"
      ],
      "revision": "integration",
      "notApplicableReasons": [
        "reviewed-docs-only"
      ]
    },
    {
      "id": "macos-browser",
      "job": "validate-macos",
      "argv": [
        "yarn",
        "test:e2e:ci"
      ],
      "timeoutSeconds": 180,
      "zeroSkips": false,
      "scope": [
        "portfolio"
      ],
      "revision": "integration",
      "notApplicableReasons": [
        "reviewed-docs-only"
      ]
    }
